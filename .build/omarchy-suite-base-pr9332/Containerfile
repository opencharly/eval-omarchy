# Layer: omarchy-pr-9332
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
RUN --mount=type=bind,from=omarchy-pr-9332,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
rm -rf /tmp/pr-src
git init -q /tmp/pr-src
cd /tmp/pr-src
git remote add origin https://github.com/omacom/omarchy
git fetch -q --depth 1 origin pull/9332/head
git checkout -q FETCH_HEAD
cp bin/omarchy-hw-hybrid-gpu /usr/share/omarchy/bin/omarchy-hw-hybrid-gpu
cp bin/omarchy-toggle-hybrid-gpu /usr/share/omarchy/bin/omarchy-toggle-hybrid-gpu
rm -f /usr/share/omarchy/default/systemd/system-sleep/force-igpu
rm -rf /usr/share/omarchy/default/systemd/system/supergfxd.service.d
OVCMD

