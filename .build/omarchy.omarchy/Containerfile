# .build/omarchy.omarchy/Containerfile (generated -- do not edit)

ARG BASE_IMAGE=ghcr.io/opencharly/arch:check-omarchy-suite-pod-pr9332-2026.244.2026

FROM scratch AS omarchy-repo
COPY .build/_candy/omarchy-repo.2026.242.0000/ /

FROM scratch AS omarchy-runtime
COPY .build/_candy/omarchy-runtime.2026.242.0000/ /

FROM scratch AS omarchy-skel
COPY .build/_candy/omarchy-skel.2026.242.0000/ /

FROM scratch AS omarchy-base
COPY .build/_candy/omarchy-base.2026.242.0000/ /

FROM ${BASE_IMAGE}

USER root

# Layer: github.com/opencharly/layer-omarchy-base/candy/omarchy-repo
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
ENV OMARCHY_CHANNEL="stable"
RUN --mount=type=bind,from=omarchy-repo,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
# Capture before overwriting. `|| true` because a base image with no
# NoExtract rules at all is legitimate — the [omarchy] rules below are
# then the only ones, which is correct rather than an error.
inherited=$(grep -E '^NoExtract' /etc/pacman.conf || true)
case "${OMARCHY_CHANNEL}" in
  stable) mirror=stable-mirror.omarchy.org ;;
  edge)   mirror=mirror.omarchy.org ;;
  rc)     mirror=rc-mirror.omarchy.org ;;
  *) echo "unknown OMARCHY_CHANNEL=${OMARCHY_CHANNEL} (stable|edge|rc)" >&2; exit 1 ;;
esac
cat > /etc/pacman.conf <<PACMANCONF
[options]
# Upstream's own [options] (default/pacman/pacman-stable.conf) with two
# deliberate omissions:
#
#  - Color/ILoveCandy/VerbosePkgLists are cosmetic and only add escape
#    codes to a build log.
#  - DownloadUser = alpm is DROPPED, and this is not a style choice.
#    It makes pacman drop privileges to the alpm user for downloads,
#    but charly mounts /var/cache/pacman/pkg as a root-owned build
#    cache, which alpm cannot write to. Measured: the whole transaction
#    dies with "failed to synchronize all databases (failed to retrieve
#    some files)". Upstream can use it because a real install writes to
#    a normal directory; a cache-mounted build cannot.
#
# HoldPkg is kept — a cheap safety net against removing pacman or glibc.
HoldPkg = pacman glibc
Architecture = auto
CheckSpace
ParallelDownloads = 5
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

NoExtract = usr/share/libalpm/hooks/80-limine-efi-deploy.hook
NoExtract = usr/share/libalpm/hooks/10-limine-snapper-lock.hook
NoExtract = usr/share/libalpm/hooks/60-limine-mkinitcpio-remove-pre.hook
NoExtract = usr/share/libalpm/hooks/90-limine-mkinitcpio-remove-post.hook
NoExtract = etc/pacman.d/hooks/90-mkinitcpio-install.hook
${inherited}

[core]
Server = https://${mirror}/\$repo/os/\$arch

[extra]
Server = https://${mirror}/\$repo/os/\$arch

[multilib]
Server = https://${mirror}/\$repo/os/\$arch

[omarchy]
SigLevel = Optional TrustAll
Server = https://pkgs.omarchy.org/${OMARCHY_CHANNEL}/\$arch
PACMANCONF
OVCMD
RUN --mount=type=bind,from=omarchy-repo,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
pacman-key --init
pacman-key --populate archlinux
pacman-key --recv-keys 40DFB630FF42BCFFB047046CF0134EE680CAC571
pacman-key --lsign-key 40DFB630FF42BCFFB047046CF0134EE680CAC571
# -Syy, NOT -Sy. The base image ships a sync DB already populated from
# UPSTREAM Arch, and Omarchy's mirror is a SNAPSHOT — its databases are
# deliberately older. `pacman -Sy` compares freshness and keeps the
# newer local DB, so the repoint above would silently have no effect:
# pacman would resolve upstream Arch versions and then 404 fetching them
# from the snapshot, which serves only its own. Observed exactly that:
# the DB offered qt6-base 6.11.2-3 (upstream) while the mirror serves
# 6.11.2-2. A forced refresh is the documented way to switch mirrors.
pacman -Syy --noconfirm
OVCMD
RUN --mount=type=bind,from=omarchy-repo,source=/,target=/ctx --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
set -eu
pacman -Syuu --noconfirm
OVCMD

# Layer: github.com/opencharly/layer-omarchy-base/candy/omarchy-runtime
RUN --mount=type=cache,id=charly-var-cache-pacman-pkg,dst=/var/cache/pacman/pkg,sharing=locked \
pacman-key --init && \
# Reseed pacman keyring from the locally-installed
# keyring packages (cachyos-keyring, archlinux-keyring).
# `--populate` is local-only and FAST (sub-second per
# repo); does NOT do keyserver roundtrips. Non-fatal
# (`|| true`) so air-gapped / restricted-network builds
# succeed when the keyring was already current.
(pacman-key --populate 2>/dev/null || true) && \
OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Syu --noconfirm --needed omarchy omarchy-settings gum jq git perl fakeroot pacman-contrib expac less man-db unzip inetutils whois socat inotify-tools plocate libsecret gnome-keyring libyaml lua51 luarocks

# Layer: github.com/opencharly/layer-omarchy-base/candy/omarchy-skel
ARG TARGETARCH
ENV ARCH=${TARGETARCH}
USER 1000
RUN --mount=type=bind,from=omarchy-skel,source=/,target=/ctx --mount=type=cache,id=charly-tmp-npm-cache-uid1000,dst=/tmp/npm-cache,uid=1000,gid=1000 sh -c 'SH=/bin/sh; [ -x /bin/bash ] && SH=/bin/bash; exec "$SH"' sh <<'OVCMD'
BUILD_ARCH=$(uname -m)
case "$BUILD_ARCH" in
  x86_64) ARCH=amd64 ;;
  aarch64) ARCH=arm64 ;;
  armv7l|armv7|armhf) ARCH=arm ;;
  *) ARCH=$BUILD_ARCH ;;
esac
export BUILD_ARCH ARCH
set -e
cp -af /etc/skel/. "${HOME}/"
OVCMD
USER root

# Layer: github.com/opencharly/layer-omarchy-base/candy/omarchy-base

USER 1000
