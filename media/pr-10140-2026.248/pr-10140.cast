[0.009, "o", "1:echo \"Apply Omarchy's USB autosuspend policy through the kernel command line\"\r\n"]
[0.000, "o", "4:legacy_conf=\"${OMARCHY_USB_AUTOSUSPEND_LEGACY_CONF:-/etc/modprobe.d/omarchy-usb-autosuspend.conf}\"\r\n"]
[0.000, "o", "11:  [[ $(<\"$legacy_conf\") == \"options usbcore autosuspend=-1\" ]]; then\r\n"]
[0.000, "o", "17:grep -Fq 'usbcore.autosuspend=-1' \"$defaults_conf\" || exit 0\r\n"]
[0.000, "o", "23:if [[ \" $(<\"$running_cmdline\") \" != *\" usbcore.autosuspend=-1 \"* ]]; then\r\n"]
[0.000, "o", "pr-10140-done\r\n"]
