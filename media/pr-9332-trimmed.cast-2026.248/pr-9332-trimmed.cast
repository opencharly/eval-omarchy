[2.275, "o", "grep -n cardwire /usr/share/omarchy/bin/omarchy-toggle-hybrid-gpu; echo toggle-check-done"]
[0.167, "o", "\r\n\u001b[?2004l\r"]
[0.002, "o", "3:# omarchy:summary=Toggle dedicated vs integrated GPU mode via cardwire (for hybrid gpu laptops, like Asus G14).\r\n6:if omarchy-cmd-missing cardwire; then\r\n7:  omarchy-pkg-add cardwire || exit 1\r\n9:  sudo systemctl enable --now cardwired\r\n13:# retire it so it can't fight cardwire over the dGPU.\r\n"]
[0.000, "o", "23:  if output=$(timeout --kill-after=1s 3s cardwire get 2>/dev/null) &&\r\n33:  echo \"cardwired is not responding. Try again, or check: systemctl status cardwired\" >&2\r\n40:    cardwire set hybrid || exit 1\r\n"]
[0.001, "o", "45:    cardwire set integrated || exit 1\r\n"]
[0.000, "o", "toggle-check-done\r\n"]
[0.007, "o", "\u001b]0;user@omarchy:~\u0007"]
[0.000, "o", "\u001b[?2004h\r\n"]
