# large / transient build + run artifacts — never committed
.build/
.check/
.containerignore
.dockerignore
# the per-PR recordings live INSIDE the record dir now (eval/pr-<N>/media/) and
# are ignored by the rule below; the old top-level media/ layout is retired.
media/
eval/*/media/
output/
capture/
*.bak*
*.log
__pycache__/
*.pyc
.rollup-cache.json

# large binary artifacts — a TYPE-level safety net so a disk image / recording /
# screenshot can never be committed even if it lands OUTSIDE the dirs above
# (the dir patterns cover media/ + output/, these cover a stray path).
*.qcow2
*.qcow
*.iso
*.raw
*.img
*.vmdk
*.vdi
*.mp4
*.mjpeg
*.m4v
*.mov
*.webm
*.mkv
*.avi
*.gif
*.cast
*.png
*.jpg
*.jpeg

# Deliberately NOT ignored (tracked as the lane produces them) so a fresh clone
# can rerun every eval and read every result:
#   eval/pr-<N>/charly.yml   the per-PR eval beds (treatment + negative control)
#   eval/pr-<N>/eval.yml     the single per-PR record (oracle + eval + control +
#                            gates + cold-read + the user-voice report + media links)
#   eval/omarchy-acceptance-matrix.md  the generated acceptance-corpus matrix
# The recordings under eval/pr-<N>/media/ ARE ignored (the rule above).

# VM disk images (configurable root; default `image`, the vm.image_dir setting)
image/

# transient per-run pipeline ledger dumps (never committed). The engine writes
# one PER LANE (`stage-findings-pr-<pr>.yml`) so concurrent batch lanes cannot
# overwrite each other's forensics; the bare `stage-findings.yml` is the
# no-PR single-entity form. The glob covers both.
stage-findings*.yml
